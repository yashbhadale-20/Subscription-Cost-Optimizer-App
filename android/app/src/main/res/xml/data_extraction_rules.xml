<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" stops cloud backup, but on Android 12+ device-to-device transfer is governed
    by these rules. Session tokens and settings stay on the device they were issued to.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
